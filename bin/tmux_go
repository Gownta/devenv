#!/usr/bin/python3

"""
tmux_go will attach to the running tmux server, creating one if
it doesn't exist

References:
- tmux wiki:
    https://github.com/tmux/tmux/wiki
- tmux man page:
    https://man7.org/linux/man-pages/man1/tmux.1.html
"""

"""
Notes on new-session:
-d; do not attach session to shell
-e, like new-window
-c start_directory
-n window-name
-s session-name
-t group-name; new windows are added to this group, which could be a session-name
-A: behave like attach-session if session-name exists

Notes on new-window:
> If -d is given, the session does not make the new window the current window.
> -e takes the form ‘VARIABLE=value’ ... it may be specified multiple times.
- -n window-name

Notes on split-window:
> -h does a horizontal split and -v a vertical split
- -l 50%
> All other options have the same meaning as for the new-window command
- ...such as -t target-window
"""


import datetime
import os
import shutil
import subprocess
import sys


# Socket set with tmux's -S flag
# Within tmux, run `tmux display -p '#{socket_path}'` to see the path
tmux_dir = os.path.join(os.getenv("NJORMROD_DEVENV"), "workspace", "tmux")
os.makedirs(tmux_dir, exist_ok=True)
socket_dir = os.path.join(tmux_dir, "tmux_socket")
log_path = os.path.join(tmux_dir, "tmux_go.log")


def log(msg):
    """Diagnostics go to stderr and to log_path.

    The log file matters because the interesting failures happen while
    attaching, when whatever is on stderr tends to get wiped or scrolled away
    by the terminal handoff.
    """
    print(f"tmux_go: {msg}", file=sys.stderr)
    stamp = datetime.datetime.now().isoformat(timespec="seconds")
    with open(log_path, "a") as f:
        f.write(f"{stamp} {msg}\n")


def describe_fd(name, fd):
    """Describe an fd the way tmux cares about it.

    isatty() alone is not the test: the tmux client sends ttyname(stdin) to
    the server, and an fd that is a tty but has no reachable /dev/pts entry
    sends an empty name -- which the server reports as "not a terminal".
    """
    try:
        ttyname = os.ttyname(fd)
    except OSError as e:
        ttyname = f"<none: {e.strerror}>"
    try:
        target = os.readlink(f"/proc/self/fd/{fd}")
    except OSError as e:
        target = f"<{e.strerror}>"
    return f"{name}(isatty={os.isatty(fd)} ttyname={ttyname} fd->{target})"


def tmux(s, **kwargs):
    cmd = ["tmux", "-S", socket_dir] + s.split()
    #print(" ".join(cmd))
    return subprocess.run(cmd, **kwargs)


def get_panes_config():
    # Search for a panes file, taking the first that exists
    candidate_paths = [os.path.expanduser("~/.tmux.panes")]
    envrcdir = os.getenv("ENVRCDIR")
    if envrcdir:
        candidate_paths.append(os.path.join(envrcdir, "tmux.panes"))
    for path in candidate_paths:
        if os.path.isfile(path):
            with open(path, "r") as f:
                return f.read()
    raise FileNotFoundError(
        f"No tmux.panes file found in: {', '.join(candidate_paths)}"
    )


def check_server_binary():
    """Warn when the running server predates a tmux upgrade.

    A tmux server keeps executing the binary it started with; a package
    upgrade replaces the one on disk. Both may report the same protocol
    version, so has-session/list-windows/new-session keep working and nothing
    looks wrong -- but the identify handshake has changed underneath, the
    server never registers the client's stdin fd, and attach-session dies with
    "open terminal failed: not a terminal". Chasing that as a tty problem is a
    dead end, so name it up front.

    Returns the path to a recovered matching binary, or None.
    """
    ret = tmux("display -p #{pid}", text=True, capture_output=True)
    if ret.returncode != 0:
        return None
    pid = ret.stdout.strip()
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return None
    if not exe.endswith("(deleted)"):
        return None

    # The deleted binary is still readable through /proc, so a client that
    # matches the server can be recovered rather than losing the session.
    recovered = os.path.join(tmux_dir, "tmux-server-binary")
    try:
        shutil.copyfile(f"/proc/{pid}/exe", recovered)
        os.chmod(recovered, 0o755)
        version = subprocess.run(
            [recovered, "-V"], text=True, capture_output=True
        ).stdout.strip()
    except OSError as e:
        log(f"could not recover the server's binary: {e}")
        recovered, version = None, "unknown"

    on_disk = subprocess.run(
        ["tmux", "-V"], text=True, capture_output=True
    ).stdout.strip()
    log(f"server (pid {pid}) runs a DELETED binary: {version}; on disk: {on_disk}")
    log("tmux was upgraded under the running server -- attach will likely fail")
    if recovered:
        log(f"to attach anyway: {recovered} -S {socket_dir} attach -t me")
    return recovered


def start():
    # Get the terminal size
    cols, rows = shutil.get_terminal_size()

    # Load pane info
    panes_config = get_panes_config()

    # Session name
    session_name = "me"

    tmux("start-server")
    ret = tmux(f"has-session -t {session_name}", capture_output=True)
    if ret.returncode == 1:
        for i, line in enumerate(panes_config.rstrip().splitlines()):
            wname, wdir = line.split(' ', maxsplit=1)
            wdir = os.path.realpath(os.path.expanduser(wdir))
            cmd = "session -d -s" if i == 0 else "window -t"
            tmux(f"new-{cmd} {session_name} -n {wname} -c {wdir} ")
            #tmux(f"resize-window -t {i+1} -x {cols} -y {rows - 1}")
            tmux(f"splitw -h -c {wdir}")
        tmux("select-window -t 1")
    rebalance()

    check_server_binary()

    # attach-session is the one command here that needs a terminal: the client
    # hands the server ttyname(stdin), and an empty one gets refused with
    # "open terminal failed: not a terminal". Capture stderr (safe -- the
    # server draws onto the stdin fd, not stdout) so a failure can be
    # explained rather than just printed and lost.
    ret = tmux(
        f"attach-session -d -t {session_name}",
        stderr=subprocess.PIPE,
        text=True,
    )
    if ret.returncode != 0:
        err = (ret.stderr or "").strip()
        log(f"attach-session failed (exit {ret.returncode}): {err}")
        for name, fd in (("stdin", 0), ("stdout", 1), ("stderr", 2)):
            log(describe_fd(name, fd))
        log(
            f"env: TERM={os.getenv('TERM')!r} TMUX={os.getenv('TMUX')!r} "
            f"SSH_TTY={os.getenv('SSH_TTY')!r} socket={socket_dir}"
        )
        if not os.isatty(0):
            log(
                "stdin is not a terminal -- attach needs one. Run tmux_go from "
                "an interactive shell, or allocate a pty: `ssh -t <host> "
                "tmux_go`. The session itself is up; reattach any time."
            )
        elif "<none:" in describe_fd("stdin", 0):
            log(
                "stdin IS a tty but has no ttyname -- the /dev/pts entry is "
                "unreachable from here (mount namespace, container, chroot). "
                "That is why tmux disagrees with you about being in a terminal."
            )
        sys.exit(ret.returncode)


def rebalance():
    windows = tmux("list-windows", text=True, capture_output=True).stdout
    n_windows = len(windows.splitlines())
    for i in range(n_windows):
        tmux(f"select-layout -t {i+1}.1 even-horizontal")


def clear():
    windows = tmux("list-windows", text=True, capture_output=True).stdout
    n_windows = len(windows.splitlines())
    for i in range(n_windows):
        tmux(f"send-keys -t {i+1}.1 clear Enter")
        tmux(f"send-keys -t {i+1}.2 clear Enter")


if __name__ == "__main__":
    if len(sys.argv) > 1:
        cmd = sys.argv[1][:1].lower()
        if cmd == "rebalance"[0]:
            rebalance()
        elif cmd == "clear"[0]:
            clear()
        else:
            print(f"unrecognized subcommand {sys.argv[1]}")
    else:
        start()
